{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OpenCharm",
  "version": "../package.json",
  "identifier": "dev.opencharm.desktop",
  "build": {
    "frontendDist": "../dist",
    "beforeDevCommand": "npm run web",
    "beforeBuildCommand": "npm run web"
  },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "charm",
        "url": "desktop.html",
        "title": "OpenCharm",
        "width": 313,
        "height": 38,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "resizable": false,
        "skipTaskbar": true,
        "shadow": false,
        "focus": false,
        "visible": false,
        "acceptFirstMouse": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg", "nsis"],
    "category": "Productivity",
    "shortDescription": "The charm, without the hardware",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../charmd/": "charmd/"
    },
    "macOS": {
      "entitlements": "Entitlements.plist",
      "minimumSystemVersion": "12.0",
      "signingIdentity": "-"
    }
  }
}
