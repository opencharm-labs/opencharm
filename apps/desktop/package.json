{
  "name": "@opencharm-labs/desktop",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "The desktop charm: OpenCharm under your Mac's notch",
  "scripts": {
    "web": "tsx scripts/build-web.ts",
