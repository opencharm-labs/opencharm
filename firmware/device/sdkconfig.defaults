# The Waveshare ESP32-S3-Touch-AMOLED-2.16: ESP32-S3R8 (8 MB octal PSRAM), 16 MB flash.
CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=4096
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_FREERTOS_HZ=1000
# The core and LVGL run in the main task: one loop, no threads (firmware/README.md).
CONFIG_ESP_MAIN_TASK_STACK_SIZE=16384
# Logs over the USB-C port (the board's USB is the ESP32-S3's own USB-Serial/JTAG).
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_COMPILER_OPTIMIZATION_PERF=y

# LVGL: the same settings as firmware/core/lv_conf.h, except memory: on the board LVGL takes it
# from the C library (PSRAM for anything large) instead of a fixed 512 KB pool in internal RAM.
CONFIG_LV_CONF_SKIP=y
CONFIG_LV_COLOR_DEPTH_16=y
CONFIG_LV_OS_NONE=y
CONFIG_LV_USE_CLIB_MALLOC=y
CONFIG_LV_DEF_REFR_PERIOD=16
CONFIG_LV_DPI_DEF=220
CONFIG_LV_DRAW_SW_COMPLEX=y
# CONFIG_LV_USE_LOG is not set
CONFIG_LV_USE_ASSERT_NULL=y
CONFIG_LV_USE_ASSERT_MALLOC=y
CONFIG_LV_FONT_MONTSERRAT_14=y
# CONFIG_LV_USE_THEME_DEFAULT is not set
CONFIG_LV_USE_THEME_SIMPLE=y
# CONFIG_LV_BUILD_EXAMPLES is not set
# CONFIG_LV_BUILD_DEMOS is not set
