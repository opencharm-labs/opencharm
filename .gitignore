# Dependencies and build output
node_modules/
dist/
.next/
out/
coverage/
*.tsbuildinfo
next-env.d.ts

# Python
__pycache__/
*.pyc
.venv/
.ruff_cache/

# Secrets never enter the repo; examples do.
.env
.env.*
!.env.example

# Local agent state and process scratch (plans live in specs/, not here)
.claude/settings.local.json
docs/superpowers/
.superpowers/

# OS and slicer files
.DS_Store
*.3mf
*.gcode

# CMake build trees (charm-core fetches LVGL, cJSON, doctest into them)
firmware/core/build/

# npm pack output (testing the package before a release)
*.tgz

# Built emulator (npm run firmware:sim); shipped in the npm package, never committed
packages/cli/sim/
firmware/sim/build/

# Agent worktrees (Claude Code isolation), never part of the repo
.claude/worktrees/

# The charmd the desktop app carries, staged by apps/desktop/scripts/stage-charmd.ts (spec 013).
apps/desktop/charmd/*
!apps/desktop/charmd/.gitkeep
